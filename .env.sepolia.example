# ForteL2 Phase 2 (Sepolia) — operator-local only.
# Copy to .env.sepolia and fill addresses + keys OFFLINE.
# Never commit .env.sepolia. Never paste private keys into agent chat.
#
# Load with:  FORTEL2_ENV=.env.sepolia ./scripts/...
# Phase 1 (.env / chain 901) stays untouched.

# --- Paths ---
FORTEL2_ROOT=/Users/steveforte/ForteL2
BIN_DIR=/Users/steveforte/ForteL2/bin
# --- Tooling pins (same pair as .env.example; P:0 proven floor, Task 1) ---
# optimism op-node/v1.19.2 (da197e45) | op-geth v1.101702.2 | op-reth/v2.3.3 (Reth Version: 2.3.0-dev, commit 9384bc53d8c0c77e59cac83fdaaf3b372c6d2216) | op-deployer 0.7.1
# Separate datadir from Phase 1 Anvil stack
DATA_DIR=/Users/steveforte/src/fortel2/data-sepolia
DEPLOY_DIR=/Users/steveforte/ForteL2/deployments/sepolia/.deployer

# --- Chain IDs ---
# Ethereum Sepolia L1; private learning L2 (not a public chain id)
L1_CHAIN_ID=11155111
L2_CHAIN_ID=852

# --- L1 RPC (Phase 2d: QuickNode HTTPS; same var, no redeploy) ---
# Use a Mac-mini-only QuickNode endpoint here. Render replica gets a *separate*
# endpoint URL in fortel2-replica Render secrets (never share the same token).
# Near QuickNode credit cap on Render: set L1_USE_PUBLIC_RPC=1 there (publicnode);
# keep the QuickNode URL in Render's L1_RPC_URL and flip the flag back to 0 for catch-up.
# Public (rate-limited) examples for smoke / Render credit-safe mode:
#   https://ethereum-sepolia-rpc.publicnode.com
#   https://rpc.sepolia.org
# QuickNode: dashboard → Ethereum → Sepolia → copy HTTPS URL into L1_RPC_URL locally
# REPLICA_L2_RPC_URL unset — replica is a Render private service with no Mac-reachable URL; sync drill runs via the Render Web Shell (see tasks/decisions.md D-0016)
L1_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional until blob DA / leaving beacon-ignore; not required for Phase 2d
# 09-start-challenger-sepolia.sh requires L1_BEACON_URL (this binary's CheckRequired);
# op-node still uses --l1.beacon.ignore (D-0037). Do not uncomment a placeholder.
# L1_BEACON_URL=

# --- L2 stays loopback (US-012 GO; D-0034 cloudflared dials the write filter
# on L2_WRITE_RPC_PORT only — never :9545. Do not set L2_RPC_URL to a Cloudflare
# hostname. Tunnel token / Access client secret never belong in this file.) ---
L1_BLOCK_TIME=12
L2_BLOCK_TIME=2
L2_EL_HTTP_PORT=9545
L2_EL_WS_PORT=9546
L2_EL_AUTH_PORT=9551
L2_NODE_RPC_PORT=9547
L2_RPC_URL=http://127.0.0.1:9545
L2_NODE_RPC_URL=http://127.0.0.1:9547
# T5-D1 write-facing filter (eth/net/web3 allowlist) — cloudflared dials this, not :9545
# Live tunnel yaml: config/cloudflared-write.yml (gitignored). LaunchAgent:
# com.steve.fortel2-cloudflared. Do not put the tunnel token or CF-Access-Client-Secret here.
L2_WRITE_RPC_PORT=9555
DAPP_HTTP_PORT=8080
VIEWER_HTTP_PORT=8081
# Shared with Phase 1 defaults — cannot run both stacks at once
BATCHER_RPC_PORT=8548
PROPOSER_RPC_PORT=8560

# --- Harvest wallet (funded; never a signer for deploy/batcher/proposer) ---
HARVEST_ADDRESS=0x5128889F20Ec13e0Be38b2BeBC568594159B652d

# --- Fresh Sepolia roles (generate offline with: cast wallet new) ---
# Fill ADDRESS fields in the committed example copy; PRIVATE_KEY only in local .env.sepolia
# ADMIN_PRIVATE_KEY must derive ADMIN_ADDRESS (any case). 02-deploy-contracts-sepolia.sh
# refuses a mismatch or empty key before any spend or wipe (F7-10; see README
# § Network reset procedure and tasks/prd-phase-7-fault-proofs.md § Operator sequence).
ADMIN_ADDRESS=
ADMIN_PRIVATE_KEY=
BATCHER_ADDRESS=
BATCHER_PRIVATE_KEY=
PROPOSER_ADDRESS=
PROPOSER_PRIVATE_KEY=
SEQUENCER_ADDRESS=
SEQUENCER_PRIVATE_KEY=
CHALLENGER_ADDRESS=
CHALLENGER_PRIVATE_KEY=
# Pre-image oracle server for --cannon-server (cannon game type only; D-0054).
# CHALLENGER_CANNON_SERVER=
# Pre-image oracle server for --cannon-kona-server (cannon-kona game type only; D-0054).
# CHALLENGER_KONA_SERVER=

# Optional L2 demo wallets (fund via bridge in Phase 2c — no genesis fundDevAccounts)
# DEMO_A_ADDRESS=
# DEMO_A_PRIVATE_KEY=
# DEMO_B_ADDRESS=
# DEMO_B_PRIVATE_KEY=

# --- Batcher / proposer (credit-budget defaults for metered L1 RPC) ---
BATCHER_DA_TYPE=calldata
# P7-0-A: op-batcher --batch-type (UintFlag: 0=singular, 1=span). Default span.
# One-line revert (restarts stock if already running): BATCHER_BATCH_TYPE=singular
BATCHER_BATCH_TYPE=span
PROPOSER_GAME_TYPE=1
# Sepolia proposer cadence (script default 1h; D-0074). Do NOT set Phase-1 PROPOSER_INTERVAL=12s
# here — 06-start-proposer-sepolia.sh ignores it and uses SEPOLIA_PROPOSER_INTERVAL only.
SEPOLIA_PROPOSER_INTERVAL=1h
# Optional overrides (scripts already default to these when unset):
# SEPOLIA_BATCHER_POLL_INTERVAL=12s
# SEPOLIA_BATCHER_MAX_CHANNEL_DURATION=30
# SEPOLIA_BATCHER_TXMGR_RECEIPT_QUERY_INTERVAL=36s
# SEPOLIA_BATCHER_TXMGR_REBROADCAST_INTERVAL=36s
# SEPOLIA_PROPOSER_POLL_INTERVAL=12s
# SEPOLIA_PROPOSER_TXMGR_RECEIPT_QUERY_INTERVAL=36s
# SEPOLIA_PROPOSER_TXMGR_REBROADCAST_INTERVAL=36s
# SEPOLIA_PROPOSER_RESUBMISSION_TIMEOUT=72s
# SEPOLIA_L1_HTTP_POLL_INTERVAL=12s
# SEPOLIA_L1_RPC_RATE_LIMIT=20
# SEPOLIA_L1_RPC_KIND=quicknode  # op-node receipts path; rollback: standard
# Funding gate: a below-floor primary read asks this URL at the same pinned
# block before aborting a start (D-0106). One-shot corroboration only — not
# serving L1, and deliberately exempt from the PublicNode-as-serving-L1
# refusal (D-0102 / assert_sepolia_rpc_urls). An explicit value that shares
# origin with L1_RPC_URL is refused. If unset, default is PublicNode; when
# that origin is also L1_RPC_URL (this example), the gate falls back to
# https://rpc.sepolia.org rather than fail-closing.
# SEPOLIA_L1_CORROBORATION_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Faster demo cadence (burns credits):
#   SEPOLIA_BATCHER_MAX_CHANNEL_DURATION=2 SEPOLIA_BATCHER_POLL_INTERVAL=2s SEPOLIA_PROPOSER_INTERVAL=12s
# Phase 4 US-044 (optional, careful): custom batcher demo — never the default.
#   USE_CUSTOM_BATCHER=1 CONFIRM_CUSTOM_BATCHER_SEPOLIA=1
#   Max ~15 min; then stop and revert to stock 05-start-batcher-sepolia.sh (see batcher/README.md).
# Phase 5 US-054 (optional, careful): custom proposer demo — never the default.
#   USE_CUSTOM_PROPOSER=1 CONFIRM_CUSTOM_PROPOSER_SEPOLIA=1
#   Max ~15 min; then stop and revert to stock 06-start-proposer-sepolia.sh (see proposer/README.md).

# --- Learning-short portal delays (Phase 2b intent; mainnet is ~7d / ~3.5d) ---
# ASSIGN EACH OF THESE EXACTLY ONCE. This file is loaded with `set -a; source`, so a
# later duplicate silently wins and the file reads as though the first value applied.
# That happened on 2026-08-21 and shadowed four of the six (D-0065). The deploy
# script now refuses a duplicated assignment of any of the six on every run.
# NOTE: the Sepolia redeploy EXECUTED 2026-08-22 with these six values (D-0068).
# FORCE_SEPOLIA_REDEPLOY=1 would wipe the network a SECOND time. The guidance
# below applies to the next redeploy (mainnet pilot), not to chain 852 today.
# Choose ALL SIX in one sitting before FORCE_SEPOLIA_REDEPLOY=1 (file values win
# over inline env). These six are the clock/delay immutables (D-0046). They are
# not the type-8 prestate: leave FAULT_GAME_ABSOLUTE_PRESTATE unset for the wipe
# — 02-deploy-contracts-sepolia.sh refuses that combo (D-0061). The code gate
# (additional-game stanza, CI prestate workflow, kona-host, the ADMIN key/address
# pairing guard F7-10, and the duplicate/absent-immutable guard F7-11).
# F7-11 has landed: 02-deploy-contracts-sepolia.sh refuses a duplicated
# assignment of any of these six on every run, and an absent or empty one
# when FORCE_SEPOLIA_REDEPLOY=1 or FAULT_GAME_ABSOLUTE_PRESTATE is set
# (D-0056/D-0060/D-0065; README step 1b). The hash
# itself is FAULT_GAME_ABSOLUTE_PRESTATE at the second apply, after the network
# is healthy (below). Skip the code gate and the new chain cannot be challenged:
# op-deployer's default prestate is a stale cannon32 artifact, and game types
# 0/1 bind to op-program, which this monorepo does not contain.
# PermissionedDisputeGame.initialize requires:
#   maxClockDuration >= max(2*clockExtension, clockExtension+preimageOracleChallengePeriod)
# The numbers below are the 2026-07-22 pinned deploy (clocks 5/10; preimage
# period left at op-deployer's 86400). Those clocks cannot create() a game.
# Phase 7 proposed learning values (write into local .env.sepolia, never commit
# the chosen set here): extension=600, max=7200, preimage=3600, plus the two
# proof/finality delays and FAULT_GAME_WITHDRAWAL_DELAY — see
# tasks/prd-phase-7-fault-proofs.md. 02-deploy-contracts-sepolia.sh refuses a
# combo that would revert InvalidClockExtension after the wipe (D-0046).
PROOF_MATURITY_DELAY_SECONDS=12
DISPUTE_GAME_FINALITY_DELAY_SECONDS=6
FAULT_GAME_CLOCK_EXTENSION=5
FAULT_GAME_MAX_CLOCK_DURATION=10
FAULT_GAME_WITHDRAWAL_DELAY=1
PREIMAGE_ORACLE_CHALLENGE_PERIOD=86400

# Step 8b only (D-0061): a *second* op-deployer apply after the network is
# healthy, registering game type 8 (cannon-kona) with MakeRespected. NEVER set
# this for the wipe (FORCE_SEPOLIA_REDEPLOY=1) — 02-deploy-contracts-sepolia.sh
# refuses that combo because any prestate present at wipe time commits to the
# old rollup config. Value comes from the CI prestate build (D-0059 / D-0061),
# not from op-deployer's built-in cannon32 default (D-0056).
# FAULT_GAME_ABSOLUTE_PRESTATE=

# --- Phase 7 challenger / L1 batch proxy / safedb (US-073) ---
# Isolated: not started by start-all-sepolia.sh. Fill these in local
# .env.sepolia (gitignored). Empty or commented here on purpose.

# Safe-head DB so op-challenger can judge (D-0082). Without it the challenger
# starts but every judgment fails with "safe head database not enabled".
# Set before start-all-sepolia.sh (cold-start-only). Derived data; wipe-safe.
# OP_NODE_SAFEDB_PATH=$DATA_DIR/safedb

# L1_BEACON_URL is required by 09-start-challenger-sepolia.sh CheckRequired
# (--l1-beacon). Fill it in local .env.sepolia from the L1 RPC placeholder
# above — do not add a second assignment here (a later KEY= silently wins,
# D-0065). Does not enable blob DA (op-node still --l1.beacon.ignore).

# Playable path is cannon-kona (game type 8, D-0077). No script default.
CHALLENGER_TRACE_TYPE=

# Local Kona prestate artifact. Must be an absolute path (start_bg chdirs to /).
# Shape: /abs/path/to/prestate.bin.gz (fill in local .env.sepolia).
CHALLENGER_PRESTATE=

# Challenger L1 via the batch-splitting proxy (D-0081). Unset = direct L1_RPC_URL.
# Start the proxy first: ./scripts/start-l1-batch-proxy-sepolia.sh
# Default listen is http://127.0.0.1:9549 (L1_BATCH_PROXY_PORT).
CHALLENGER_L1_RPC_URL=

# Optional challenger scan-cost knobs (09-start-challenger-sepolia.sh → CLI flags).
# Script defaults are cheaper than the binary (poll 12s / update 0s / concurrency=NumCPU).
# Safe vs this chain's clocks: FAULT_GAME_MAX_CLOCK_DURATION=7200, extension=600 (D-0082).
# game-window left unset on purpose — binary 672h covers bond-claim buffer; do not shrink.
# SEPOLIA_CHALLENGER_HTTP_POLL_INTERVAL=300s
# SEPOLIA_CHALLENGER_MIN_UPDATE_INTERVAL=300s
# SEPOLIA_CHALLENGER_MAX_CONCURRENCY=1
# SEPOLIA_CHALLENGER_GAME_WINDOW=
# Binary-native names also accepted as fallbacks when SEPOLIA_* is unset:
# OP_CHALLENGER_HTTP_POLL_INTERVAL=
# OP_CHALLENGER_MIN_UPDATE_INTERVAL=
# OP_CHALLENGER_MAX_CONCURRENCY=
# OP_CHALLENGER_GAME_WINDOW=
# Init-path 429 retry (D-0107): grace after start_bg + bounded attempts (not infinite).
# CHALLENGER_START_GRACE_SEC=15
# CHALLENGER_START_ATTEMPTS=3

# Optional L1 batch-proxy knobs (scripts/l1-batch-proxy.py / start-l1-batch-proxy-sepolia.sh).
# L1_BATCH_PROXY_PORT=9549
# L1_BATCH_PROXY_CHUNK=40
# L1_BATCH_PROXY_PACE_SEC=1.0

# --- Ops alerting (alert-watch.sh / com.steve.fortel2-alerts) ---
# macOS banner always fires. Email is the Resend HTTP API. Fill these in local
# .env.sepolia (gitignored) — never here. Keep the TOKEN assignment empty in
# this tracked copy; CI fails a populated one (#145). The secret is named
# RESEND_API_TOKEN on purpose (the tripwire matches names containing TOKEN).
# Empty ALERT_EMAIL_FROM falls back to onboarding@resend.dev, which delivers
# only to the Resend account owner until a domain is verified. Do not put a
# real token or a real email address in this file.
RESEND_API_TOKEN=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Funding watch (funding-watch.sh / daily health agent) ---
# Optional knobs for the external-funder liveness check. Scripts already
# default to the values below when unset; leave those commented here so an
# empty KEY= cannot override a default (D-0065). HTTP corroboration needs
# both the URL and the token; fill them in local .env.sepolia (gitignored)
# — never here. Keep the TOKEN assignment empty in this tracked copy; CI
# fails a populated one (#145). Do not put a real URL or token in this file.
# FUNDING_HEALTH_JSON is test-only (local file instead of HTTP) and is
# deliberately not templated.
# FUNDING_POLICY_MIN_ETH=0.6
# FUNDING_STALE_HOURS=12
# FUNDING_WATCH_ADDRESS=
# FUNDING_HEALTH_TIMEOUT=10
# CHAINBANK_FUNDING_HEALTH_URL=
FUNDING_HEALTH_TOKEN=
