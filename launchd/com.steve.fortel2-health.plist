<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.steve.fortel2-health</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/steveforte/ForteL2/refresh_health.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>5</integer>
    <key>Minute</key>
    <integer>5</integer>
  </dict>
  <!--
    Log under ~/Library/Logs (always present on macOS). Do NOT use repo data/:
    that dir is gitignored and only created inside refresh_health.sh; launchd
    opens StandardOutPath/StandardErrorPath before the program runs, so a
    missing parent directory fails the job on a fresh clone.
  -->
  <key>StandardOutPath</key>
  <string>/Users/steveforte/Library/Logs/fortel2-health.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/steveforte/Library/Logs/fortel2-health.err.log</string>
</dict>
</plist>
